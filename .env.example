# ══════════════════════════════════════════════════════════════════════
# CEVOP — Environment Variables Reference
# Copy to server/.env and apps/*/.env and fill in values
# NEVER commit actual secrets to git
# ══════════════════════════════════════════════════════════════════════

# ── server/.env ─────────────────────────────────────────────────────

# Database — get connection strings from Supabase → Settings → Database
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth secrets — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-64-char-hex"
ACCESS_TOKEN_SECRET="generate-64-char-hex"

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated, no spaces
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"

# Frontend URLs — used in email links and QR codes
ADMIN_DASHBOARD_URL="http://localhost:5175"
CUSTOMER_PWA_URL="http://localhost:5173"

# Email — Resend ( `https://resend.com)`
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Cevop <noreply@cevop.com>"

# Rate limiting — Upstash Redis ( `https://upstash.com)`
# Falls back to in-memory if not set (not suitable for production)
UPSTASH_REDIS_REST_URL=" `https://your-instance.upstash.io` "
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# WhatsApp Business API (optional — notifications disabled if absent)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Logging
LOG_LEVEL=info


# ── apps/*/.env ─────────────────────────────────────────────────────
# Create a .env file in each app directory containing:
# VITE_API_URL=http://localhost:4000
#
# Ops dashboard only:
# VITE_ADMIN_DASHBOARD_URL=http://localhost:5175


# ── Production checklist (Railway) ──────────────────────────────────
# Set these in Railway environment variables:
#   DATABASE_URL
#   DIRECT_URL
#   JWT_SECRET
#   ACCESS_TOKEN_SECRET
#   PORT=4000
#   NODE_ENV=production
#   ALLOWED_ORIGINS (all 4 Vercel URLs + cevop.com domains)
#   ADMIN_DASHBOARD_URL= `https://app.cevop.com`
#   CUSTOMER_PWA_URL= `https://order.cevop.com`
#   RESEND_API_KEY
#   EMAIL_FROM
#   UPSTASH_REDIS_REST_URL
#   UPSTASH_REDIS_REST_TOKEN
#   LOG_LEVEL=warn

# ── Production checklist (Vercel — each of 4 apps) ──────────────────
#   VITE_API_URL= `https://your-app.up.railway.app`
#   (must use https:// — http:// causes Mixed Content errors)
#
# Ops dashboard only:
#   VITE_ADMIN_DASHBOARD_URL= `https://admin.cevop.com`
