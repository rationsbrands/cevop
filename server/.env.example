# Copy to server/.env and fill in values

# DATABASE_URL is used by the app at runtime via the connection pooler.
# connection_limit=10 — Prisma's default formula (2*CPUs+1) is too low for a busy server.
# pool_timeout=20 — wait up to 20s for a free connection before erroring.
# For Supabase Transaction Mode (port 6543) keep connection_limit ≤ your Supabase plan's max.
DATABASE_URL="postgresql://postgres.pufmzsmjfeoaiopgfyte:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# DIRECT_URL is used only by Prisma CLI for migrations and introspection (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.pufmzsmjfeoaiopgfyte:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-char-random-hex-here"

# Separate secret for signing access tokens — allows independent rotation from refresh tokens
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET="your-64-char-random-hex-here"

PORT=4000
NODE_ENV=development

ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
ADMIN_DASHBOARD_URL="http://localhost:5175"
CUSTOMER_PWA_URL="http://localhost:5173"

# Web Push (VAPID)
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:support@cevop.com"

# Optional WhatsApp Cloud API notifications
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

LOG_LEVEL=info

# Get your API key at resend.com — free tier is 3,000 emails/month
# Transactional email (Resend — https://resend.com)
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Cevop <noreply@yourdomain.com>"

# Redis (Upstash) — for persistent rate limiting across restarts and instances
# Get free credentials at https://console.upstash.com — create a Redis database, copy REST URL and token
# If not set, rate limiters fall back to in-memory (fine for single-instance dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Push notifications (Web Push VAPID)
VAPID_PUBLIC_KEY="
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@cevop.com"

# Supabase Storage — for clock-in selfie photos
# Get these from your Supabase project: Settings → API
# SUPABASE_URL is the Project URL (e.g. https://xyzabc.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY is the secret service_role key (NOT the anon key)
# If not set, clock-in photos are skipped silently — system still works.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

SENTRY_DSN      =    from sentry.io
AXIOM_TOKEN      =    from axiom.co
AXIOM_DATASET     =  cevop-production