generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Organization {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  logo             String?
  whatsappNumber   String?
  slackWebhook     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  timezone         String            @default("Africa/Lagos")
  currency         String            @default("NGN")
  isActive         Boolean           @default(true)
  plan             String            @default("free")
  planStatus       String            @default("active")
  trialEndsAt      DateTime?
  verifiedAt       DateTime?
  verifiedBy       String?
  selfSignup       Boolean           @default(false)
  contactPhone     String?
  contactEmail     String?
  notes            String?
  notifyNewOrders       Boolean @default(true)
  notifyWaiterCalls     Boolean @default(true)
  notifyServiceRequests Boolean @default(true)
  scheduledForDeletionAt DateTime?
  auditLogs        AuditLog[]
  branches         Branch[]
  categories       Category[]
  helpOptions      HelpOption[]
  inviteTokens     InviteToken[]
  menuItems        MenuItem[]
  onboardingTokens OnboardingToken[]
  orders           Order[]
  serviceRequests  ServiceRequest[]
  tables           Table[]
  users            User[]
  waiterCalls      WaiterCall[]
  tableSessions    TableSession[]
  sections         Section[]
  pushSubscriptions PushSubscription[]

  @@map("organizations")
}

model Branch {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  address         String?
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  email           String?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories      Category[]
  helpOptions     HelpOption[]
  inviteTokens    InviteToken[]
  menuItems       MenuItem[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  tables          Table[]
  users           User[]
  waiterCalls     WaiterCall[]
  tableSessions   TableSession[]
  sections        Section[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("branches")
}

model HelpOption {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String
  type           HelpOptionType @default(SERVICE)
  label          String
  icon           String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  branch         Branch         @relation(fields: [branchId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("help_options")
}

model User {
  id                  String         @id @default(cuid())
  organizationId      String
  name                String
  email               String
  passwordHash        String
  role                UserRole       @default(WAITER)
  isActive            Boolean        @default(true)
  isOnShift           Boolean        @default(false)
  shiftStartedAt      DateTime?
  shiftEndedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  branchId            String?
  loginAttempts       Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  passwordResetToken  String?        @unique
  passwordResetExpiry DateTime?
  mustChangePassword  Boolean        @default(false)
  opsRole             OpsRole?
  staffCode           String?
  emailVerified       DateTime?
  emailVerificationToken String?     @unique
  waiterCallAssignments    WaiterCall[]     @relation("WaiterCallAssignments")
  serviceRequestAssignments ServiceRequest[] @relation("ServiceRequestAssignments")
  orderWaiterAssignments   Order[]          @relation("OrderWaiterAssignments")
  sectionAssignments  SectionStaff[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  pushSubscriptions   PushSubscription[]
  branch              Branch?        @relation(fields: [branchId], references: [id])
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@unique([branchId, staffCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  branchId       String?
  app            String
  endpoint       String       @unique
  subscription   Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId])
  @@index([userId])
  @@map("push_subscriptions")
}

model OnboardingToken {
  id             String       @id @default(cuid())
  organizationId String
  token          String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("onboarding_tokens")
}

model InviteToken {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  email          String
  role           UserRole
  token          String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@map("invite_tokens")
}

model Table {
  id              String           @id @default(cuid())
  organizationId  String
  label           String
  number          Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branchId        String
  status          TableStatus      @default(EMPTY)
  activeSessionId String?
  sectionId       String?
  section         Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sessions        TableSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  branch          Branch           @relation(fields: [branchId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waiterCalls     WaiterCall[]

  @@unique([branchId, number])
  @@index([organizationId])
  @@index([branchId])
  @@map("tables")
}

model TableSession {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String
  tableId        String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  closedBy       String?
  guestCount     Int?
  notes          String?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch           @relation(fields: [branchId], references: [id])
  table          Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders         Order[]
  waiterCalls    WaiterCall[]
  serviceRequests ServiceRequest[]

  @@index([tableId, closedAt])
  @@index([branchId, closedAt])
  @@index([organizationId])
  @@map("table_sessions")
}

model Section {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  name           String        // e.g. "Main Floor", "Patio", "Bar"
  colour         String?       // hex colour for visual floor map — optional
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id])
  tables         Table[]
  staff          SectionStaff[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@map("sections")
}

model SectionStaff {
  id         String   @id @default(cuid())
  sectionId  String
  userId     String
  assignedAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, userId])
  @@index([sectionId])
  @@index([userId])
  @@map("section_staff")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, isActive])
  @@map("categories")
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  image          String?
  isAvailable    Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@index([organizationId, isAvailable])
  @@index([categoryId, isAvailable])
  @@map("menu_items")
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  tableId        String
  idempotencyKey String       @unique
  status         OrderStatus  @default(RECEIVED)
  total          Decimal      @db.Decimal(10, 2)
  notes          String?
  cancellationReason String?
  sessionId      String?
  session        TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedWaiter     String?
  assignedWaiterAt   DateTime?
  assignedWaiterUser User?    @relation("OrderWaiterAssignments", fields: [assignedWaiter], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String
  items          OrderItem[]
  branch         Branch       @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table          Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, createdAt(sort: Desc)])
  @@index([assignedWaiter])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?
  cancelledAt   DateTime?
  cancelReason  String?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model WaiterCall {
  id             String           @id @default(cuid())
  organizationId String
  tableId        String
  reason         String?
  status         WaiterCallStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  branchId       String
  notes          String?
  resolvedBy     String?
  resolvedAt     DateTime?
  assignedTo   String?
  assignedAt   DateTime?
  sessionId    String?
  session      TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation("WaiterCallAssignments", fields: [assignedTo], references: [id], onDelete: SetNull)
  branch         Branch           @relation(fields: [branchId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table          Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@index([assignedTo])
  @@map("waiter_calls")
}

model ServiceRequest {
  id             String               @id @default(cuid())
  organizationId String
  tableId        String
  serviceType    String
  notes          String?
  status         ServiceRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  branchId       String
  adminNotes     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  assignedTo   String?
  assignedAt   DateTime?
  sessionId    String?
  session      TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation("ServiceRequestAssignments", fields: [assignedTo], references: [id], onDelete: SetNull)
  branch         Branch               @relation(fields: [branchId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table          Table                @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@index([assignedTo])
  @@map("service_requests")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  ipAddress      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum HelpOptionType {
  WAITER
  SERVICE
  BILL
}

enum UserRole {
  SUPERADMIN
  ORG_OWNER
  ADMIN
  ORG_MANAGER
  ORG_FINANCE
  ORG_AUDITOR
  BRANCH_FINANCE
  SERVICE
  WAITER
  KITCHEN
  BRANCH_ADMIN
}

enum OpsRole {
  SUPER
  SUPPORT
  BILLING
  READONLY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
  CLEANING
}
