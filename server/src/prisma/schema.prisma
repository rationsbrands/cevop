generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  slug                   String             @unique
  logo                   String?
  whatsappNumber         String?
  slackWebhook           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  timezone               String             @default("Africa/Lagos")
  currency               String             @default("NGN")
  isActive               Boolean            @default(true)
  plan                   String             @default("free")
  planStatus             String             @default("active")
  trialEndsAt            DateTime?
  verifiedAt             DateTime?
  verifiedBy             String?
  selfSignup             Boolean            @default(false)
  contactPhone           String?
  contactEmail           String?
  notes                  String?
  taxRate                Decimal            @default(0.00) @db.Decimal(5, 2)
  serviceChargeRate      Decimal            @default(0.00) @db.Decimal(5, 2)
  notifyNewOrders        Boolean            @default(true)
  notifyWaiterCalls      Boolean            @default(true)
  notifyServiceRequests  Boolean            @default(true)
  qrOrderingEnabled      Boolean            @default(true)
  scheduledForDeletionAt DateTime?
  auditLogs              AuditLog[]
  branches               Branch[]
  categories             Category[]
  helpOptions            HelpOption[]
  inviteTokens           InviteToken[]
  menuItems              MenuItem[]
  onboardingTokens       OnboardingToken[]
  orders                 Order[]
  serviceRequests        ServiceRequest[]
  tables                 Table[]
  users                  User[]
  waiterCalls            WaiterCall[]
  tableSessions          TableSession[]
  sections               Section[]
  stations               Station[]
  pushSubscriptions      PushSubscription[]
  payments               Payment[]
  StaffShift             StaffShift[]
  // Inventory
  inventoryCategories    InventoryCategory[]
  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  purchaseOrders         PurchaseOrder[]
  stocktakes             Stocktake[]
  wastageEntries         WastageEntry[]
  suppliers              Supplier[]
  // Finance
  expenses               Expense[]

  @@map("organizations")
}

model Branch {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  address            String?
  phone              String?
  isActive           Boolean          @default(true)
  useOrgMenu         Boolean          @default(true)
  serviceModel       ServiceModel     @default(TABLE_SERVICE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  email              String?
  maxTablesPerWaiter Int?
  taxRate            Decimal?         @db.Decimal(5, 2)
  serviceChargeRate  Decimal?         @db.Decimal(5, 2)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories         Category[]
  helpOptions        HelpOption[]
  inviteTokens       InviteToken[]
  menuItems          MenuItem[]
  orders             Order[]
  serviceRequests    ServiceRequest[]
  tables             Table[]
  users              User[]
  waiterCalls        WaiterCall[]
  tableSessions      TableSession[]
  sections           Section[]
  payments           Payment[]
  stations           Station[]
  StaffShift         StaffShift[]
  expenses           Expense[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("branches")
}

model Station {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  name           String // e.g. "Kitchen", "Bar", "Grill"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  menuItems    MenuItem[]
  orderItems   OrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@map("stations")
}

model HelpOption {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String
  type           HelpOptionType @default(SERVICE)
  label          String
  icon           String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  branch         Branch         @relation(fields: [branchId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("help_options")
}

model User {
  id                        String             @id @default(cuid())
  organizationId            String
  name                      String
  email                     String
  passwordHash              String
  role                      UserRole           @default(WAITER)
  isActive                  Boolean            @default(true)
  isOnShift                 Boolean            @default(false)
  shiftStartedAt            DateTime?
  shiftEndedAt              DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  branchId                  String?
  loginAttempts             Int                @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  lastLoginIp               String?
  passwordResetToken        String?            @unique
  passwordResetExpiry       DateTime?
  mustChangePassword        Boolean            @default(false)
  opsRole                   OpsRole?
  staffCode                 String?
  emailVerified             DateTime?
  emailVerificationToken    String?            @unique
  // Payroll
  salaryType                SalaryType         @default(MONTHLY)
  hourlyRate                Decimal?           @db.Decimal(10, 2)
  monthlySalary             Decimal?           @db.Decimal(12, 2)
  workingDaysPerMonth       Int                @default(22)
  waiterCallAssignments     WaiterCall[]       @relation("WaiterCallAssignments")
  serviceRequestAssignments ServiceRequest[]   @relation("ServiceRequestAssignments")
  orderWaiterAssignments    Order[]            @relation("OrderWaiterAssignments")
  sessionAssignments        TableSession[]     @relation("SessionWaiterAssignments")
  sectionAssignments        SectionStaff[]
  auditLogs                 AuditLog[]
  refreshTokens             RefreshToken[]
  pushSubscriptions         PushSubscription[]
  processedPayments         Payment[]          @relation("PaymentProcessor")
  orderItemCancellations    OrderItem[]        @relation("OrderItemCancellations")
  resolvedWaiterCalls       WaiterCall[]       @relation("WaiterCallResolutions")
  resolvedServiceRequests   ServiceRequest[]   @relation("ServiceRequestResolutions")
  shifts                    StaffShift[]
  recordedExpenses          Expense[]          @relation("ExpenseRecorder")
  approvedExpenses          Expense[]          @relation("ExpenseApprover")
  branch                    Branch?            @relation(fields: [branchId], references: [id])
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@unique([branchId, staffCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  branchId       String?
  app            String
  endpoint       String       @unique
  subscription   Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId])
  @@index([userId])
  @@map("push_subscriptions")
}

model OnboardingToken {
  id             String       @id @default(cuid())
  organizationId String
  token          String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("onboarding_tokens")
}

model InviteToken {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  email          String
  role           UserRole
  token          String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@map("invite_tokens")
}

model Table {
  id              String           @id @default(cuid())
  organizationId  String
  label           String
  number          Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branchId        String
  status          TableStatus      @default(EMPTY)
  activeSessionId String?
  sectionId       String?
  section         Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sessions        TableSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  branch          Branch           @relation(fields: [branchId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waiterCalls     WaiterCall[]

  @@unique([branchId, number])
  @@index([organizationId])
  @@index([branchId])
  @@map("tables")
}

model TableSession {
  id               String    @id @default(cuid())
  organizationId   String
  branchId         String
  tableId          String?
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  closedBy         String?
  assignedWaiterId String?
  assignedWaiterAt DateTime?
  claimedAt        DateTime?
  guestCount       Int?
  notes            String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id])
  table           Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  assignedWaiter  User?            @relation("SessionWaiterAssignments", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  orders          Order[]
  waiterCalls     WaiterCall[]
  serviceRequests ServiceRequest[]
  payments        Payment[]

  @@index([tableId, closedAt])
  @@index([branchId, closedAt])
  @@index([organizationId])
  @@index([assignedWaiterId])
  @@index([branchId, openedAt(sort: Desc)])
  @@map("table_sessions")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id                  String        @id @default(cuid())
  sessionId           String
  organizationId      String
  branchId            String
  amount              Decimal       @db.Decimal(10, 2)
  subtotal            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  currency            String        @default("NGN")
  method              PaymentMethod
  reference           String?
  note                String?
  ordersTotal         Decimal       @db.Decimal(10, 2)
  processedBy         String?
  processedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  session      TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  processor    User?        @relation("PaymentProcessor", fields: [processedBy], references: [id])
  orderItems   OrderItem[]  @relation("PaymentOrderItems")

  @@index([sessionId])
  @@index([branchId, processedAt])
  @@index([branchId, processedAt(sort: Desc)], map: "payments_branchId_processedAt_desc_idx")
  @@index([organizationId])
  @@map("payments")
}

model Section {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  name           String // e.g. "Main Floor", "Patio", "Bar"
  colour         String? // hex colour for visual floor map — optional
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id])
  tables       Table[]
  staff        SectionStaff[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@map("sections")
}

model SectionStaff {
  id         String   @id @default(cuid())
  sectionId  String
  userId     String
  assignedAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, userId])
  @@index([sectionId])
  @@index([userId])
  @@map("section_staff")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, isActive])
  @@map("categories")
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  categoryId     String
  stationId      String?
  name           String
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  image          String?
  isAvailable    Boolean      @default(true)
  trackStock     Boolean      @default(false)
  stockCount     Int          @default(0)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  station        Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  recipeLines    RecipeLine[]

  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@index([stationId])
  @@index([organizationId, isAvailable])
  @@index([categoryId, isAvailable])
  @@map("menu_items")
}

model Order {
  id                  String        @id @default(cuid())
  organizationId      String
  tableId             String?
  idempotencyKey      String        @unique
  orderType           OrderType     @default(DINE_IN)
  orderNumber         Int?
  customerName        String?
  status              OrderStatus   @default(RECEIVED)
  subtotal            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  notes               String?
  cancellationReason  String?
  sessionId           String?
  session             TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedWaiter      String?
  assignedWaiterAt    DateTime?
  assignedWaiterUser  User?         @relation("OrderWaiterAssignments", fields: [assignedWaiter], references: [id], onDelete: SetNull)
  acknowledgedAt      DateTime?
  escalationLevel     Int           @default(0)
  lastEscalatedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  branchId            String
  items               OrderItem[]
  branch              Branch        @relation(fields: [branchId], references: [id])
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table               Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, createdAt(sort: Desc)])
  @@index([assignedWaiter])
  @@index([branchId, orderType, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  menuItemId      String
  stationId       String?
  paymentId       String?
  quantity        Int
  unitPrice       Decimal         @db.Decimal(10, 2)
  notes           String?
  status          OrderItemStatus @default(PENDING)
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  cancelledByUser User?           @relation("OrderItemCancellations", fields: [cancelledBy], references: [id], onDelete: SetNull)
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station         Station?        @relation(fields: [stationId], references: [id], onDelete: SetNull)
  payment         Payment?        @relation("PaymentOrderItems", fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([stationId])
  @@index([paymentId])
  @@map("order_items")
}

model WaiterCall {
  id              String           @id @default(cuid())
  organizationId  String
  tableId         String?
  reason          String?
  status          WaiterCallStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branchId        String
  notes           String?
  resolvedBy      String?
  resolvedByUser  User?            @relation("WaiterCallResolutions", fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  assignedTo      String?
  assignedAt      DateTime?
  acknowledgedAt  DateTime?
  escalationLevel Int              @default(0)
  lastEscalatedAt DateTime?
  sessionId       String?
  session         TableSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedUser    User?            @relation("WaiterCallAssignments", fields: [assignedTo], references: [id], onDelete: SetNull)
  branch          Branch           @relation(fields: [branchId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table           Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@index([assignedTo])
  @@map("waiter_calls")
}

model ServiceRequest {
  id              String               @id @default(cuid())
  organizationId  String
  tableId         String?
  serviceType     String
  notes           String?
  status          ServiceRequestStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  branchId        String
  adminNotes      String?
  resolvedBy      String?
  resolvedByUser  User?                @relation("ServiceRequestResolutions", fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  assignedTo      String?
  assignedAt      DateTime?
  acknowledgedAt  DateTime?
  escalationLevel Int                  @default(0)
  lastEscalatedAt DateTime?
  sessionId       String?
  session         TableSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedUser    User?                @relation("ServiceRequestAssignments", fields: [assignedTo], references: [id], onDelete: SetNull)
  branch          Branch               @relation(fields: [branchId], references: [id])
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table           Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@index([assignedTo])
  @@map("service_requests")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  ipAddress      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationLog {
  id             String   @id @default(cuid())
  organizationId String
  type           String // 'whatsapp' | 'push' | 'email'
  recipient      String // phone or userId
  event          String // 'NEW_ORDER' | 'WAITER_CALL' etc
  status         String // 'sent' | 'failed' | 'delivered'
  error          String?
  sentAt         DateTime @default(now())

  @@index([organizationId, sentAt])
  @@map("notification_logs")
}

enum HelpOptionType {
  WAITER
  SERVICE
  BILL
}

model StaffShift {
  id              String     @id @default(cuid())
  organizationId  String
  branchId        String?
  userId          String
  clockedInAt     DateTime
  clockedOutAt    DateTime?
  durationMinutes Int?
  // Pay snapshot — copied from User at clock-in so payroll is immutable
  salaryType      SalaryType @default(MONTHLY)
  hourlyRate      Decimal?   @db.Decimal(10, 2)
  monthlySalary   Decimal?   @db.Decimal(12, 2)
  breakMinutes    Int        @default(0)
  overtimeMinutes Int        @default(0)
  lateMinutes     Int        @default(0)
  payAmount       Decimal?   @db.Decimal(12, 2)
  notes           String?
  approvedBy      String?
  isApproved      Boolean    @default(false)
  clockInPhotoUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
  @@index([clockedInAt])
  @@map("staff_shifts")
}

enum UserRole {
  BAR
  SUPERADMIN
  ORG_OWNER
  ADMIN
  ORG_MANAGER
  ORG_FINANCE
  ORG_AUDITOR
  BRANCH_FINANCE
  SERVICE
  WAITER
  KITCHEN
  CASHIER
  HOST
  BRANCH_ADMIN
}

enum OpsRole {
  SUPER
  SUPPORT
  BILLING
  READONLY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum ServiceModel {
  TABLE_SERVICE
  COUNTER_SERVICE
  BOTH
}

enum SalaryType {
  HOURLY
  MONTHLY
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
  CLEANING
}

// ─── INVENTORY ────────────────────────────────────────────────────────────────

enum UnitOfMeasure {
  KG
  G
  LB
  OZ
  L
  ML
  PCS
  BOX
  CARTON
  BAG
  BOTTLE
  PACK
  PORTION
  SERVING
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  MANUAL_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  WRITE_OFF
  STOCKTAKE_ADJUSTMENT
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum WastageReason {
  EXPIRED
  SPILLAGE
  DAMAGED
  OVER_PREP
  QUALITY_REJECTION
  THEFT
  OTHER
}

model InventoryCategory {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          InventoryItem[]

  @@index([organizationId])
  @@map("inventory_categories")
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  paymentTerms   String?
  leadTimeDays   Int?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          InventoryItem[] @relation("SupplierItems")
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

model InventoryItem {
  id               String        @id @default(cuid())
  organizationId   String
  branchId         String
  categoryId       String?
  supplierId       String?       // preferred supplier
  name             String
  sku              String?
  barcode          String?
  description      String?
  unitOfMeasure    UnitOfMeasure @default(PCS)
  packSize         Decimal?      @db.Decimal(10, 3) // e.g. 12 if sold in packs of 12
  costPrice        Decimal       @default(0.00) @db.Decimal(12, 2)
  sellingPrice     Decimal?      @db.Decimal(12, 2)
  currentStock     Decimal       @default(0.00) @db.Decimal(12, 3)
  reorderPoint     Decimal       @default(0.00) @db.Decimal(12, 3)
  reorderQuantity  Decimal       @default(0.00) @db.Decimal(12, 3)
  expiryTracking   Boolean       @default(false)
  yieldPercent     Decimal       @default(100.00) @db.Decimal(5, 2) // for food: usable % after prep
  isActive         Boolean       @default(true)
  imageUrl         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation("SupplierItems", fields: [supplierId], references: [id], onDelete: SetNull)
  movements       StockMovement[]
  wastageEntries  WastageEntry[]
  recipeLines     RecipeLine[]
  poLines         PurchaseOrderLine[]

  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@index([organizationId, isActive])
  @@map("inventory_items")
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  itemId         String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3) // positive = in, negative = out
  unitCost       Decimal           @default(0.00) @db.Decimal(12, 2)
  referenceId    String?           // orderId, poId, stocktakeId, etc.
  referenceType  String?           // 'ORDER' | 'PO' | 'STOCKTAKE' | 'MANUAL' etc.
  note           String?
  createdBy      String?
  createdAt      DateTime          @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([itemId])
  @@index([createdAt])
  @@index([referenceId, referenceType])
  @@map("stock_movements")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  organizationId   String
  branchId         String
  supplierId       String
  poNumber         String?             // human-readable e.g. PO-2026-001
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  subtotal         Decimal             @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal             @default(0.00) @db.Decimal(12, 2)
  total            Decimal             @default(0.00) @db.Decimal(12, 2)
  notes            String?
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  lines          PurchaseOrderLine[]

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantityOrdered Decimal  @db.Decimal(12, 3)
  quantityReceived Decimal @default(0.00) @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(12, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  notes           String?

  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item           InventoryItem @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

model Stocktake {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String
  reference      String?   // e.g. "June Weekly Count"
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  conductedBy    String?
  notes          String?
  varianceValue  Decimal?  @db.Decimal(12, 2)
  isBlindCount   Boolean   @default(true) // staff can't see expected qty
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          StocktakeLine[]

  @@index([organizationId])
  @@index([branchId])
  @@map("stocktakes")
}

model StocktakeLine {
  id           String    @id @default(cuid())
  stocktakeId  String
  itemId       String
  expectedQty  Decimal   @db.Decimal(12, 3)
  countedQty   Decimal?  @db.Decimal(12, 3)
  variance     Decimal?  @db.Decimal(12, 3) // counted - expected
  varianceCost Decimal?  @db.Decimal(12, 2)
  note         String?

  stocktake    Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  @@index([stocktakeId])
  @@index([itemId])
  @@map("stocktake_lines")
}

model WastageEntry {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  itemId         String
  quantity       Decimal       @db.Decimal(12, 3)
  unitCost       Decimal       @db.Decimal(12, 2)
  totalCost      Decimal       @db.Decimal(12, 2)
  reason         WastageReason @default(OTHER)
  notes          String?
  loggedBy       String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           InventoryItem @relation(fields: [itemId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([itemId])
  @@index([createdAt])
  @@map("wastage_entries")
}

// Recipe — links MenuItem (Restaurant OS) to InventoryItems
// Only used by Restaurant OS; Inventory module has no dependency on this
model RecipeLine {
  id          String   @id @default(cuid())
  menuItemId  String   // FK to MenuItem
  itemId      String   // FK to InventoryItem
  quantity    Decimal  @db.Decimal(12, 4) // quantity of ingredient per 1 portion
  unit        UnitOfMeasure
  notes       String?

  item        InventoryItem @relation(fields: [itemId], references: [id])
  menuItem    MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, itemId])
  @@index([menuItemId])
  @@index([itemId])
  @@map("recipe_lines")
}

// ─── Finance Module ────────────────────────────────────────────────────────────

enum ExpenseCategory {
  RENT
  UTILITIES
  MAINTENANCE
  MARKETING
  SALARY_SUPPLEMENT
  EQUIPMENT
  SUPPLIES
  TRANSPORT
  INSURANCE
  PROFESSIONAL_FEES
  OTHER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model Expense {
  id                  String              @id @default(cuid())
  organizationId      String
  branchId            String?
  category            ExpenseCategory
  amount              Decimal             @db.Decimal(12, 2)
  currency            String              @default("NGN")
  description         String
  date                DateTime
  isRecurring         Boolean             @default(false)
  recurringFrequency  RecurringFrequency?
  attachmentUrl       String?
  recordedBy          String?
  approvedBy          String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?      @relation(fields: [branchId], references: [id])
  recorder      User?        @relation("ExpenseRecorder", fields: [recordedBy], references: [id])
  approver      User?        @relation("ExpenseApprover", fields: [approvedBy], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}
