{
  "name": "cevop-server",
  "version": "1.0.0",
  "description": "Cevop API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate --schema=src/prisma/schema.prisma && tsc",
    "start": "node dist/server/src/index.js",
    "start:monitor": "node dist/server/src/scripts/stale-monitor.js",
    "postinstall": "prisma generate --schema=src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "db:seed": "ts-node src/prisma/seed.ts",
    "db:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "test": "NODE_ENV=test vitest run --exclude \"**/dist/**\" --passWithNoTests"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.6.1",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.54.0",
    "@sentry/profiling-node": "^10.54.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "redis": "^5.12.1",
    "resend": "^6.12.3",
    "socket.io": "^4.7.4",
    "web-push": "^3.6.7",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.7"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "ts-node src/prisma/seed.ts"
  }
}
